{
  "name": "inkark",
  "private": true,
  "version": "0.9.5",
  "description": "AI 写作助手",
  "author": "InkArk Contributors",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "icon:gen": "node scripts/gen-icon.cjs",
    "e2e": "vite build && npx playwright test",
    "e2e:headed": "vite build && npx playwright test --headed",
    "e2e:ui": "vite build && npx playwright test --project=ui",
    "e2e:ui:headed": "vite build && npx playwright test --project=ui --headed",
    "e2e:ai": "vite build && npx playwright test --project=ai",
    "e2e:ai:headed": "vite build && npx playwright test --project=ai --headed"
  },
  "dependencies": {
    "chardet": "^2.1.1",
    "fts5-sql-bundle": "^1.0.2",
    "iconv-lite": "^0.7.2",
    "jieba-wasm": "^2.4.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284",
    "sonner": "^2.0.7",
    "sql.js": "^1.11.0",
    "tokenx": "^1.3.0",
    "vectra": "^0.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-placeholder": "^2.11.7",
    "@tiptap/extension-underline": "^2.11.7",
    "@tiptap/pm": "^2.11.7",
    "@tiptap/react": "^2.11.7",
    "@tiptap/starter-kit": "^2.11.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.9.0",
    "lucide-react": "^0.474.0",
    "misans": "^4.1.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.6",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.inkark.app",
    "productName": "InkArk",
    "artifactName": "InkArk_Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publisherName": "InkArk"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "asar": {
      "smartUnpack": true
    },
    "asarUnpack": [
      "dist-electron/parseWorker.cjs",
      "node_modules/chardet/**",
      "node_modules/iconv-lite/**",
      "node_modules/jieba-wasm/**",
      "node_modules/mammoth/**",
      "node_modules/@xmldom/**",
      "node_modules/argparse/**",
      "node_modules/base64-js/**",
      "node_modules/bluebird/**",
      "node_modules/dingbat-to-unicode/**",
      "node_modules/jszip/**",
      "node_modules/lop/**",
      "node_modules/option/**",
      "node_modules/path-is-absolute/**",
      "node_modules/underscore/**",
      "node_modules/xmlbuilder/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/fts5-sql-bundle/dist/test",
      "!node_modules/fts5-sql-bundle/dist/*.map",
      "!node_modules/fts5-sql-bundle/README.md",
      "!node_modules/fts5-sql-bundle/LICENSE",
      "!node_modules/pdfjs-dist/**/*.mjs.map",
      "!node_modules/pdfjs-dist/**/pdf.worker*",
      "!node_modules/pdfjs-dist/legacy/",
      "!node_modules/pdfjs-dist/image_decoders/",
      "!node_modules/pdfjs-dist/web/",
      "!node_modules/pdfjs-dist/*.md",
      "!node_modules/@napi-rs/canvas",
      "!node_modules/@napi-rs/canvas-win32-x64-msvc",
      "!node_modules/@napi-rs/canvas-win32-arm64-msvc",
      "!node_modules/@napi-rs/canvas-darwin-x64",
      "!node_modules/@napi-rs/canvas-darwin-arm64",
      "!node_modules/@napi-rs/canvas-linux-x64-gnu",
      "!node_modules/@napi-rs/canvas-linux-x64-musl",
      "!node_modules/@napi-rs/canvas-linux-arm64-gnu",
      "!node_modules/@napi-rs/canvas-linux-arm64-musl",
      "!node_modules/@napi-rs/canvas-linux-arm-gnueabihf",
      "!node_modules/@napi-rs/canvas-linux-riscv64-gnu",
      "!node_modules/@napi-rs/canvas-android-arm64"
    ]
  }
}
